# 跨平台换行统一：仓库内存 LF，避免 Windows/macOS 协作时整文件 diff
* text=auto eol=lf

# 美术与二进制资源：不做任何换行转换或合并
*.png    binary
*.jpg    binary
*.jpeg   binary
*.webp   binary
*.ktx2   binary
*.basis  binary
*.glb    binary
*.fbx    binary
*.hdr    binary
*.exr    binary
*.ogg    binary
*.mp3    binary
*.wav    binary
*.woff   binary
*.woff2  binary
*.ttf    binary

# glTF 的 .gltf 是 JSON，保持文本以便 review
*.gltf   text eol=lf

# 锁文件：折叠 diff、标记为生成物
package-lock.json  -diff linguist-generated
pnpm-lock.yaml     -diff linguist-generated
yarn.lock          -diff linguist-generated
